{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".validate": "(!data.exists() && newData.child('verified').val() === false) || newData.child('verified').val() === data.child('verified').val() || auth.token.admin === true",
        "admin": { ".validate": "newData.val() === data.val() || auth.token.admin === true" },
        "connections": { "$other": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } }
      }
    },
    "requests": {
      "$to": { ".read": "auth != null && (auth.uid === $to || auth.uid === data.child('from').val())", "$request": { ".write": "auth != null && ((auth.uid === $to && newData.child('from').val() === data.child('from').val()) || (newData.child('from').val() === auth.uid && newData.child('to').val() === $to))" } }
    },
    "chats": {
      "$chatId": { ".read": "auth != null && data.child('members').child(auth.uid).val() === true", ".write": "auth != null && newData.child('members').child(auth.uid).val() === true", "members": { ".write": "auth != null && newData.child(auth.uid).val() === true" }, "messages": { "$messageId": { ".write": "auth != null && newData.child('senderId').val() === auth.uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true" } } }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && newData.val() === true && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && root.child('chats').child($chatId).child('members').child($uid).val() === true",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "channels": {
      ".read": "auth != null",
      "$channelId": {
        ".write": "auth != null && !data.exists() && newData.child('ownerId').val() === auth.uid",
        "name": { ".write": "auth != null && (auth.token.admin === true || root.child('channels').child($channelId).child('ownerId').val() === auth.uid)", ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
        "description": { ".write": "auth != null && (auth.token.admin === true || root.child('channels').child($channelId).child('ownerId').val() === auth.uid)", ".validate": "newData.isString() && newData.val().length <= 160" },
        "emoji": { ".write": "auth != null && (auth.token.admin === true || root.child('channels').child($channelId).child('ownerId').val() === auth.uid)" },
        "verified": { ".write": "auth != null && auth.token.admin === true", ".validate": "newData.val() === false || auth.token.admin === true" },
        "lastMessage": { ".write": "auth != null && root.child('channels').child($channelId).child('members').child(auth.uid).val() === true" },
        "lastAt": { ".write": "auth != null && root.child('channels').child($channelId).child('members').child(auth.uid).val() === true" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "channelMessages": {
      "$channelId": {
        ".read": "auth != null && root.child('channels').child($channelId).child('members').child(auth.uid).val() === true",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('channels').child($channelId).child('members').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid",
          ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 5000"
        }
      }
    },
    "calls": { "$callId": { ".read": "auth != null && data.child('members').child(auth.uid).val() === true", ".write": "auth != null && newData.child('members').child(auth.uid).val() === true" } },
    "presence": { "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" } }
  }
}
